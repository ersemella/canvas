{
  "name": "canvas-monorepo",
  "private": true,
  "packageManager": "pnpm@10.31.0",
  "scripts": {
    "dev": "pnpm --filter @canvas/web dev",
    "build": "pnpm --filter @canvas/engine build && pnpm --filter @canvas/web build",
    "typecheck": "tsc -b",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "games:gen": "node scripts/gen-game-registry.mjs",
    "games:check": "node scripts/gen-game-registry.mjs --check",
    "lint": "eslint packages --ext .ts,.tsx",
    "format": "prettier --write packages scripts",
    "test": "pnpm -r --if-present test",
    "e2e": "node scripts/e2e/run.mjs",
    "balance:tactics": "node scripts/balance/run.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "playwright": "1.56.1",
    "prettier": "^3.0.0",
    "typescript": "^5.3.0",
    "vite-tsconfig-paths": "^6.1.1"
  }
}
