{
  "name": "@canvas/engine",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Canvas game engine: ECS core, Canvas2D rendering, input, loaders and generic systems.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "nanoid": "^5.0.0"
  },
  "devDependencies": {
    "@canvas/configs": "workspace:*",
    "vitest": "^3.2.7"
  }
}
