{
  "name": "@canvas/games-silk-road-run",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server.ts",
    "./game.json": "./game.json"
  },
  "typesVersions": {
    "*": {
      "server": [
        "src/server.ts"
      ]
    }
  },
  "scripts": {
    "dev": "vite --config dev/vite.config.ts",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "bench:ai": "vitest bench --run src/rules/ai.bench.ts"
  },
  "peerDependencies": {
    "@canvas/engine": "workspace:^"
  },
  "devDependencies": {
    "@canvas/engine": "workspace:*",
    "vite": "^5.0.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^3.2.7"
  },
  "canvas": {
    "serverKind": "run"
  }
}
