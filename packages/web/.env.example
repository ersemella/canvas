# Base URL for the canvas-server Worker (no trailing slash).
# Used by the poker lobby and room (HTTP and WebSocket).
#
# Production: set in GitHub Actions secret SERVER_URL and injected at build time.
#   Example: https://canvas-server.<your-account>.workers.dev
#
# Local dev: leave EMPTY — Vite's dev server proxies /rooms
# to a local `wrangler dev` (started from packages/server).
VITE_API_URL=
