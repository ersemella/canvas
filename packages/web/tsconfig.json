{
  "extends": "../../configs/tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "outDir": "dist",
    "baseUrl": "src",
    "resolveJsonModule": true,
    "paths": {
      "@canvas/engine": ["../../engine/src/index.ts"],
      "@canvas/games-poker": ["../../games/poker/src/index.ts"]
    }
  },
  "include": ["src"],
  "references": [
    {"path": "../engine"},
    {"path": "../games/poker"}
  ]
}
