{
  "extends": "../../configs/tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "dist",
    "rootDir": "src",
    "baseUrl": "src",
    "lib": [
      "ES2022"
    ],
    "types": [
      "@cloudflare/workers-types"
    ],
    "noEmit": true,
    "paths": {
      "@canvas/engine/server": [
        "../engine/src/server.ts"
      ]
    }
  },
  "include": [
    "src"
  ]
}
